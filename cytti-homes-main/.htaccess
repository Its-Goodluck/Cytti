# Set default charset
AddDefaultCharset UTF-8

# Enable mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # If the request is for a real file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Otherwise, route through index.php
    RewriteRule ^(.*)$ index.php?/$1 [L]
</IfModule>

# Deny access to sensitive files (Apache 2.4+ compatible)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|ini|md|sql|log|json|yml|yaml)$">
    Require all denied
</FilesMatch>

# PHP settings for Docker/Render
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 300

# Allow index.php to handle all routes in Docker environment
DirectoryIndex index.php index.html
